.card-image-wrap{width:100%;height:145px;border-radius:12px;overflow:hidden;background:#0e0e0e;margin-bottom:8px;position:relative}
.card-image{width:100%;height:100%;display:block;object-fit:cover;transition:transform .25s ease}
.card:hover .card-image{transform:scale(1.03)}
.emoji-fallback{width:100%;height:100%;align-items:center;justify-content:center;font-size:44px}
@media(max-width:420px){.card-image-wrap{height:125px}}
